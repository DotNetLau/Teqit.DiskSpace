<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>diskspace</AssemblyName>
    <RootNamespace>Teqit.DiskSpace</RootNamespace>

    <Version>1.0.0</Version>
    <Authors>Teqit, DotNetLau</Authors>
    <Description>Fast, read-only, offline terminal tool that shows where your disk space went.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DotNetLau/Teqit.DiskSpace</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetLau/Teqit.DiskSpace</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>disk-usage;disk-space;cli;terminal</PackageTags>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>diskspace</ToolCommandName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
